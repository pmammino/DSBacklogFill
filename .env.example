# ---------------------------------------------------------------------------
# Database (Vercel Postgres)
# When you create a Vercel Postgres store and link it to the project, Vercel
# injects these automatically. For local dev, copy them from the Vercel
# dashboard (Storage -> your DB -> .env.local tab) into a .env file.
# ---------------------------------------------------------------------------
POSTGRES_PRISMA_URL="postgres://user:password@host/db?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# JIRA integration
# (Values below are pre-filled for the gdcgroup / Rotowire-Dev setup. Only the
#  API token is a secret you must supply yourself.)
# ---------------------------------------------------------------------------
# Base URL of your JIRA Cloud site, no trailing slash.
JIRA_BASE_URL="https://gdcgroup.atlassian.net"
# Email address of the account that owns the API token below.
JIRA_EMAIL="paul.mammino@gdcgroup.com"
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN="your-atlassian-api-token"
# Project the tickets are created in (the short key).
JIRA_PROJECT_KEY="RD"
# Issue type used for new requests (Task, Story, etc.).
JIRA_ISSUE_TYPE="Story"

# The person every ticket is assigned to (their Atlassian accountId, NOT email).
# This is Paul Mammino. Find another person's id via /api/jira/health or their
# JIRA profile URL.
JIRA_ASSIGNEE_ACCOUNT_ID="712020:93c31c35-3125-4b27-94c9-4a143f5ca192"

# Parent epic to nest every request under. RD-7014 = "Data Science - Backlog".
# Leave blank to create top-level issues.
JIRA_PARENT_KEY="RD-7014"

# Optional: label(s) added to every created ticket, comma-separated.
JIRA_DEFAULT_LABELS="data-science-request"
